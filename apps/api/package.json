{
  "name": "@job-tracker/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./scout": {
      "production": "./dist/scout.js",
      "default": "./src/scout.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --conditions=production dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx --env-file=../../.env src/db/table.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:migrate-notes": "tsx --env-file=../../.env src/db/migrate-notes.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1163.0",
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/client-ssm": "^3.1162.0",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/static": "^10.1.9",
    "@job-tracker/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "aws-jwt-verify": "^5.2.1",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ]
}
