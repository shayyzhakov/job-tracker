# Copy to .env and adjust. All config comes from env vars (12-factor) so the
# same build runs locally and on AWS (ECS/App Runner + RDS).
NODE_ENV=development
API_PORT=3000
# Local dev binds to localhost only; containers use the 0.0.0.0 default.
HOST=127.0.0.1
DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5432/jobtracker
TEST_DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5432/jobtracker_test
LOG_LEVEL=info
