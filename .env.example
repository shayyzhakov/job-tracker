# Copy to .env and adjust. All config comes from env vars (12-factor) so the
# same build runs locally and on AWS (Lambda + DynamoDB; see infra/README.md).
NODE_ENV=development
API_PORT=3000
# Local dev binds to localhost only; containers use the 0.0.0.0 default.
HOST=127.0.0.1
# DynamoDB Local (docker compose). On AWS only DYNAMODB_TABLE is set; credentials come from the Lambda role.
DYNAMODB_TABLE=job-tracker
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
# Tests use their own table in the same DynamoDB Local (defaults shown):
# TEST_DYNAMODB_TABLE=job-tracker-test  TEST_DYNAMODB_ENDPOINT=http://localhost:8000
LOG_LEVEL=info
# MCP endpoint at /mcp (local-only: Host must be one of MCP_ALLOWED_HOSTS)
MCP_ENABLED=true
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional gamification side layer (XP, streaks, achievements). Off = /api/v1/progress is 404.
GAMIFICATION_ENABLED=true
# Web build switch: VITE_GAMIFICATION=false removes the UI layer entirely.

# AI opportunity scout (apps/worker)
# ANTHROPIC_API_KEY=
SCOUT_SCORER=claude
SCOUT_MODEL=claude-haiku-5-5
SCOUT_SOURCES=fixture            # fixture (sample file) and/or websearch (Claude searches the web; needs ANTHROPIC_API_KEY)
# SCOUT_SEARCH_MODEL=claude-sonnet-5-5
# SCOUT_SEARCH_MAX_SEARCHES=15
# SCOUT_SEARCH_MAX_FETCHES=25
# SCOUT_SEARCH_DEADLINE_SECONDS=600
SCOUT_CRON=0 7 * * *
SCOUT_TIMEZONE=Asia/Jerusalem

# Cloud-only settings (set by the infrastructure, not needed locally):
# COGNITO_USER_POOL_ID= COGNITO_CLIENT_ID=            (turns on login for /api/v1)
# MCP_PUBLIC_URL=https://<cloudfront domain>  COGNITO_DOMAIN=<prefix>.auth.<region>.amazoncognito.com  TRUST_PROXY=true
