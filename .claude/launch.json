{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "source \"$HOME/.nvm/nvm.sh\" && pnpm dev"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "source \"$HOME/.nvm/nvm.sh\" && pnpm --filter @job-tracker/api dev"],
      "port": 3000,
      "autoPort": false
    }
  ]
}
