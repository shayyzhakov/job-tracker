{
  "name": "job-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up -d --wait dynamodb && pnpm db:setup && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:setup": "pnpm --filter @job-tracker/api db:setup",
    "db:seed": "pnpm --filter @job-tracker/api db:seed",
    "db:migrate-notes": "pnpm --filter @job-tracker/api db:migrate-notes",
    "db:migrate-company-sizes": "pnpm --filter @job-tracker/api db:migrate-company-sizes",
    "deploy:aws": "scripts/deploy.sh",
    "deploy:code": "scripts/deploy-code.sh",
    "infra:init": "scripts/infra-init.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
